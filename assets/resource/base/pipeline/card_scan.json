{
    "SC.CardScan.Config": {
        "recognition": "DirectHit",
        "attach": {
            "tabs": [
                "support",
                "produce"
            ],
            "max_scrolls_per_tab": 30,
            "max_frames": 150,
            "max_holds": 4,
            "required_order": null
        }
    },
    "SC.CardScan.Entry": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "SC.CardScan.Begin",
        "custom_action_param": {
            "config_nodes": [
                "SC.CardScan.Config"
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "SC.CardScan.Main"
        ],
        "on_error": [
            "SC.CardScan.Abort"
        ],
        "focus": {
            "Node.Action.Starting": "持有卡扫描（仅 tools/run_tasks.py --live --supervised-task 的 CardScan 单次入口可运行；点击节点默认禁用，按动作 id 放行）：首页→アイドル→アイドル一覧→サポート/プロデュース 标签逐屏滚动读取全部卡→返回首页。不改排序/筛选，每帧存私有原图，结果只进审核导入。"
        }
    },
    "SC.CardScan.Main": {
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 60000,
        "next": [
