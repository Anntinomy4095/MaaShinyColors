    "SC.CardScan.List.ScrollDown": {
        "doc": "post_delay 1000：滚轮后由 Agent 确认列表已停住（与上一帧内容不再移动）才读，并自限速每 61 s ≤28 次（宿主每动作每分钟上限 30 次；2026-10-24 前为按旧上限 12 次设的 5000）。一格位移须在 154–356 px（到底的最后一步可更短），否则 overlap_lost。 max_hit 为整次 Pipeline 的累计命中上限，160 容纳两个标签各最多80次；实际预算由 Agent 的每标签选项与监督入口总输入上限限制。",
        "enabled": false,
        "recognition": "And",
        "all_of": [
            "SC.CardScan.List.Guard",
            "SC.CardScan.Color.ScanTab",
            "SC.CardScan.Want.ScrollDown"
        ],
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 1000,
        "max_hit": 160,
        "focus": {
            "Node.Action.Starting": "アイドル一覧：已读本屏全部卡，向下滚动一格（每标签上限见选项）"
        },
        "target": [
            270,
            430,
            130,
            40
        ],
        "on_error": [
            "SC.CardScan.Abort"
        ],
        "next": [
            "SC.CardScan.List.Settled"
        ]
    },
