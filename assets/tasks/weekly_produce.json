                {
                    "name": "按目标词条",
                    "pipeline_override": {
                        "SC.WeeklyProduce.Config.Scenario": {
                            "attach": {
                                "expect_scenario": "TARGET"
                            }
                        }
                    }
                }
            ]
        },
        "Auto编队来源": {
            "type": "select",
            "label": "编队",
            "description": "自动编队：先把 Maa 选的 P、4 张 S 与嘉宾写入下面的ユニット（覆盖原队伍），不消耗。指定ユニット：用ユニット现有队伍。",
