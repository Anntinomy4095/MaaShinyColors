                    "pipeline_override": {
                        "SC.WeeklyProduce.Config.Scenario": {
                            "attach": {
                                "expect_scenario": "LP"
                            }
                        }
                    }
                },
                {
                    "name": "S.T.E.P.",
                    "pipeline_override": {
                        "SC.WeeklyProduce.Config.Scenario": {
                            "attach": {
                                "expect_scenario": "STEP"
