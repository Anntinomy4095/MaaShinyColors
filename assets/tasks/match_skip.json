        "Match回复券": {
            "type": "switch",
            "label": "参加权不足时使用回复券",
            "description": "参加权回复券（参加権回復）与参加权分开计算。暂未开放：打开后开始前会被拒绝。永不使用ジュエル。",
            "default_case": "No",
