{
    "task": [
        {
            "name": "MatchSkip",
            "label": "Match Live",
            "entry": "SC.Match.Entry",
            "default_check": true,
            "description": "先用所选编队打下一个未通关关卡推进（输了按设定重试），剩余 Fes 参加权跳过已通关的最新一关（与 Grade 共享，Grade 先打）。参加权每场后重新核对；结果不确定将暂停。",
            "option": [
                "Match推进",
                "Match编队",
                "Match失败重试",
                "Match关卡",
                "Match次数",
                "Match参加权保留",
                "Match回复券",
                "Match回复券上限",
                "Match只采样"
            ]
        }
    ],
    "option": {
        "Match推进": {
            "type": "select",
            "label": "推进",
            "default_case": "推进后跳过",
            "description": "推进后跳过：先打下一个未通关关卡（ライブ開始，每场消耗：Fes 参加权 1），打不过或参加权用完再跳过。只跳过：不打关卡。",
            "cases": [
                {
                    "name": "推进后跳过",
                    "pipeline_override": {
                        "SC.Match.Config.Play": {
                            "attach": {
                                "play": "advance"
                            }
                        }
                    }
                },
                {
                    "name": "只跳过",
                    "pipeline_override": {
                        "SC.Match.Config.Play": {
                            "attach": {
                                "play": "off"
                            }
                        }
                    }
                }
            ]
        },
