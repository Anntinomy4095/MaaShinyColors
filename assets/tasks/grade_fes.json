{
    "task": [
        {
            "name": "GradeFes",
            "label": "Grade Fes／彩排",
            "entry": "SC.Grade.Entry",
            "default_check": false,
            "description": "按所选模式打设定的局数。消耗：1 个参加权/局。确认结算并回到 Fes 主页后才继续；结果不确定将暂停。",
            "option": [
                "Grade模式",
                "Grade难度",
                "Grade每日次数",
                "Grade一次消耗",
                "Grade参加ユニット",
                "Grade参加权保留",
                "Grade回复券",
                "Grade回复券上限",
                "Grade采样每日上限",
                "Grade自动演出",
                "Grade倍速"
            ]
        }
    ],
    "option": {
        "Grade模式": {
            "type": "select",
            "label": "模式",
            "description": "正式 Fes 和彩排共享参加权。彩排在选择难度时消耗参加权并开演。",
            "default_case": "グレードフェス",
            "cases": [
                {
                    "name": "グレードフェス",
                    "pipeline_override": {
                        "SC.Grade.Config.Mode": {
                            "attach": {
                                "mode": "grade"
                            }
                        }
                    }
                },
                {
                    "name": "フェスリハーサル",
                    "pipeline_override": {
                        "SC.Grade.Config.Mode": {
                            "attach": {
                                "mode": "rehearsal"
                            }
                        }
                    }
                }
            ]
        },
        "Grade难度": {
            "type": "select",
            "label": "グレードフェス 难度",
            "description": "得分倍率 Easy ×0.75 / Normal ×1.00 / Hard ×1.25；每局消耗 1 个参加权。",
            "default_case": "Normal",
            "cases": [
                {
                    "name": "Easy",
                    "pipeline_override": {
                        "SC.Grade.Config.Difficulty": {
                            "attach": {
                                "difficulty": "Easy"
                            }
                        }
                    }
                },
                {
                    "name": "Normal",
                    "pipeline_override": {
                        "SC.Grade.Config.Difficulty": {
                            "attach": {
                                "difficulty": "Normal"
                            }
                        }
                    }
                },
                {
                    "name": "Hard",
                    "pipeline_override": {
                        "SC.Grade.Config.Difficulty": {
                            "attach": {
                                "difficulty": "Hard"
                            }
                        }
                    }
                }
            ]
        },
        "Grade每日次数": {
            "type": "select",
            "label": "每日局数（所选模式）",
            "description": "每次运行打的局数。参加权与 Match 共享，Grade 先用。关闭自动演出时只开一局，之后由你操作。",
            "default_case": "1",
