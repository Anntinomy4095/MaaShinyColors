{
    "task": [
        {
            "name": "CollaboFes",
            "label": "Collabo Fes",
            "entry": "SC.Collabo.Entry",
            "default_check": false,
            "description": "从首页横幅进入 Collabo Fes，用所选编队打所选会场的 Hard。Live 中把自己的面板拖到第 2 位后出牌。消耗：每局コラボフェスパス 1；结果不确定将暂停。",
            "option": [
                "Collabo会场",
                "Collabo满员时",
                "Collabo局数",
                "Collabo编队",
                "Collabo等级"
            ]
        }
    ],
    "option": {
        "Collabo会场": {
            "type": "select",
            "label": "会场",
            "default_case": "Vocal",
            "description": "每局打这个会场。",
            "cases": [
                {
                    "name": "Vocal",
                    "pipeline_override": {
                        "SC.Collabo.Config.Stage": {
                            "attach": {
                                "stage": "vocal"
                            }
                        }
                    }
                },
                {
                    "name": "Dance",
