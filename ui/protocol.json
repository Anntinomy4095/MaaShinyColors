          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "knowhow.scan.stop": {
      "description": "停止「扫描ノウハウ」：宿主写入停止文件（锁存）；宽限期内未退出则终止进程并标为结果不确定。始终接受。",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "knowhow.scan.status": {
      "description": "只读：扫描ノウハウ的当前状态（同 status.update 的 knowhow_scan）。",
