  "definitions": {
    "task_status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "skipped",
        "failed",
        "uncertain",
        "guard_refused",
        "takeover"
      ]
    },
    "run_config": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "option": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "task_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "tasks": {
          "$ref": "#/definitions/run_config/properties/tasks"
        },
        "removed_tasks": {
          "type": "array",
          "description": "不在当前方案中的任务名（「添加任务」可加回）。只用于显示；宿主把这些任务的 enabled 清为 false，它们不会运行，也不推导消耗。",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^.{1,64}$"
          }
        },
        "prefs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "theme": {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            "notify": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "update_channel": {
              "type": "string",
              "enum": [
                "stable",
                "beta"
              ],
              "description": "设置 → 更新：只影响检查更新时比较哪类发布"
            },
            "accent": {
              "type": "string",
              "enum": [
                "pink",
                "sky",
                "violet",
                "teal"
              ],
              "description": "设置 → 外观 主题色（仅显示）"
            },
            "font_size": {
              "type": "string",
              "enum": [
                "small",
                "normal",
                "large",
                "xlarge"
              ],
              "description": "设置 → 外观 字号（仅显示）"
            },
            "density": {
              "type": "string",
              "enum": [
                "normal",
                "compact"
              ],
              "description": "设置 → 外观 间距（仅显示）"
            },
            "reduce_motion": {
              "type": "boolean",
              "description": "设置 → 外观 减少动画（仅显示）"
            },
            "hide_chibi_visitor": {
              "type": "boolean",
              "description": "隐藏偶像访客"
            },
            "reduce_chibi_motion": {
              "type": "boolean",
              "description": "减少偶像访客动画"
            },
            "developer": {
              "type": "boolean",
              "description": "开发者选项：显示未完成/诊断任务、开发选项与离线回放；不授予任何权限"
            },
            "owned_cards": {
              "type": "object",
              "description": "持有卡牌（仅显示偏好，筛选 Produce 编队弹窗；不授予任何权限）。Wiki 卡 ID：P 卡 1 开头、S 卡 2 开头，各 10 位。",
              "additionalProperties": false,
              "properties": {
                "p": {
                  "type": "array",
                  "maxItems": 2000,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^1[0-9]{9}$"
                  }
                },
                "s": {
                  "type": "array",
                  "maxItems": 2000,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^2[0-9]{9}$"
                  }
                },
                "details": {
                  "type": "object",
                  "description": "可选：每张持有卡的 Lv 与凸数（键为上面列表中的卡 ID；缺少字段 = 未知）。只用于自动编队推荐，不授予任何权限。宿主另外丢弃不在 p/s 列表中的键。",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "limit_break": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4
                      }
                    }
                  }
                }
              }
            },
            "knowhow_wanted": {
              "type": "array",
              "description": "ノウハウ 页登记的「想要的ノウハウ」（仅显示/匹配偏好；Maa 只在本地标注哪些书满足，不授予任何权限，永不出售/保護/マーク）。名称不含控制字符、路径或引号字符。",
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^[^\\u0000-\\u001f/\\\\:<>\"'`]{1,40}$"
                  },
                  "match": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "prefix",
                      "contains"
                    ]
                  },
                  "min_level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "halo",
                      "step",
                      "any"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "center",
                      "leader",
                      "vocal",
                      "dance",
                      "visual"
                    ]
                  }
                }
              }
            },
