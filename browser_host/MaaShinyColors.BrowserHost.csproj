<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MaaShinyColors.BrowserHost</AssemblyName>
    <RootNamespace>MaaShinyColors.BrowserHost</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The WebView2 package references its unused WPF assembly transitively. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <Content Include="demo\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="demo\heartbeat.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- pipeline_actions.json is read from the repository at startup (PipelineActionTable.Default / Reload), never embedded. -->
    <!-- UI panel (U1): command whitelist embedded; static UI served from the output ui folder.
         ui\game-assets\ is optional private local content (gitignored); a missing folder simply matches nothing. -->
    <EmbeddedResource Include="..\ui\protocol.json" LogicalName="SC.UiProtocol.json" />
    <EmbeddedResource Include="app.ico" LogicalName="SC.AppIcon.ico" />
    <Content Include="..\ui\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
